{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "portfolio-api",
	"main": "src/worker.py",
	"compatibility_date": "2026-08-21",
	"compatibility_flags": [
		"python_workers"
	],
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "portfolio-knowledge",
			"remote": true
		}
	],
	"vars": {
		"APP_ENV": "production",
		"ALLOWED_ORIGINS": "https://nachosanchez.com.ar,https://www.nachosanchez.com.ar",
		"RATE_LIMIT_REQUESTS": "30",
		"RATE_LIMIT_WINDOW_SECONDS": "60"
	}
}

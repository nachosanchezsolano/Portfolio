---
import '../styles/professional-portfolio.css';
---
<!doctype html>
<html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="theme-color" content="#080808"/><meta name="description" content="Nacho Sánchez: desarrollo full stack, proyectos freelance y docencia en programación."/><link rel="canonical" href="https://nachosanchez.com.ar/"/><link rel="alternate" hreflang="es" href="https://nachosanchez.com.ar/es/"/><link rel="alternate" hreflang="en" href="https://nachosanchez.com.ar/en/"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><title>Nacho Sánchez · Full Stack Developer & Docente</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet"/></head>
<body class="entry-page"><main class="entry-shell" aria-labelledby="entry-title">
  <p class="eyebrow">FULL STACK / FREELANCE / DOCENCIA</p>
  <h1 id="entry-title">NACHO<br/><span class="acid">SÁNCHEZ /</span></h1>
  <p><span lang="es">Desarrollo software. Enseño a construirlo.</span><br/><span lang="en">I build software. I teach how to build it.</span></p>
  <nav class="entry-languages" aria-label="Elegí tu idioma / Choose your language"><a class="button button-primary" href="/es/" lang="es" data-locale="es">Entrar en español ↗</a><a class="button button-outline" href="/en/" lang="en" data-locale="en">Enter in English ↗</a></nav>
  <p class="entry-footer mono">CÓRDOBA, ARGENTINA · DESARROLLO + EDUCACIÓN</p>
</main>
<script>
  import { readPreferredLocale, rememberLocale } from '../shared/i18n/localePreference';
  // Only redirect returning visitors. New visitors can choose their language
  // without a timed navigation interrupting keyboard use or reading.
  const saved = readPreferredLocale();
  if (saved === 'es' || saved === 'en') window.location.replace(`/${saved}/`);
  document.querySelectorAll<HTMLAnchorElement>('[data-locale]').forEach(link => {
    link.addEventListener('click', () => rememberLocale(link.dataset.locale === 'es' ? 'es' : 'en'));
  });
</script></body></html>

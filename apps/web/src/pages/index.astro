---
import Chatbot from "../features/home/components/Chatbot.astro";
import { getCopy } from "../shared/i18n";
import "../styles/global.css";

const copy = getCopy("en");
const sections = [
  { id: "portfolio", label: copy.sidebar.portfolio, content: copy.sections.portfolio },
  { id: "projects", label: copy.sidebar.projects, content: copy.sections.projects },
  { id: "studies", label: copy.sidebar.studies, content: copy.sections.studies },
  { id: "career", label: copy.sidebar.career, content: copy.sections.career },
  { id: "about", label: copy.sidebar.about, content: copy.sections.about },
];
---

<html lang={copy.meta.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#080B12" />
    <meta name="description" content={copy.meta.description} />
    <title>{copy.meta.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <main class="app-shell">
      <aside class="sidebar" aria-label={copy.sidebar.sections}>
        <div class="sidebar-top">
          <div class="sidebar-brand-row">
            <a class="brand" href="/" aria-label={copy.sidebar.brand}>
              <span class="brand-glyph" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="m12 2 1.8 7.2L21 12l-7.2 1.8L12 21l-1.8-7.2L3 12l7.2-2.8L12 2Z" /></svg></span>
              <span class="brand-name">{copy.sidebar.brand}</span>
            </a>
            <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-expanded="true" aria-label={copy.sidebar.collapseMenu}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7M9 12h11" /></svg></button>
          </div>
          <button class="icon-button mobile-menu" data-menu-toggle type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="Open navigation"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg></button>
          <div class="avatar-placeholder"><span class="avatar-silhouette" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3" /><path d="M5 20c.8-3.8 3-5.7 7-5.7s6.2 1.9 7 5.7" /></svg></span><span>{copy.sidebar.avatarPlaceholder}</span></div>
        </div>
        <nav id="primary-navigation" class="nav-groups" aria-label={copy.sidebar.sections}>
          <p class="nav-label">{copy.sidebar.sections}</p>
          {sections.map((section, index) => (
            <button class:list={["nav-item", { active: index === 0 }]} type="button" data-section={section.id} aria-controls={`panel-${section.id}`} aria-current={index === 0 ? "page" : undefined}>
              <span class:list={["nav-icon", `nav-icon-${section.id}`]} aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false">
                {section.id === "portfolio" && <><rect x="4" y="4" width="16" height="16" rx="3" /><path d="M8 9h8M8 13h5" /></>}
                {section.id === "projects" && <><path d="m12 3 8 5-8 5-8-5 8-5Z" /><path d="m4 12 8 5 8-5M4 16l8 5 8-5" /></>}
                {section.id === "studies" && <><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5v-16Z" /><path d="M4 18.5A2.5 2.5 0 0 1 6.5 16H20" /></>}
                {section.id === "career" && <path d="M5 19V5M5 5h14l-4 4 4 4H5" />}
                {section.id === "about" && <><circle cx="12" cy="8" r="3" /><path d="M5 21c.8-4.1 3.1-6.2 7-6.2s6.2 2.1 7 6.2" /></>}
              </svg></span><span>{section.label}</span>
            </button>
          ))}
          <p class="nav-label recent-label">{copy.sidebar.recent}</p>
          <div class="recent-empty" aria-hidden="true"><span>—</span><small>{copy.sidebar.emptyRecent}</small></div>
        </nav>
        <div class="sidebar-footer">
          <div class="status"><span class="status-dot" aria-hidden="true"></span><span class="status-label">{copy.sidebar.status}</span></div>
          <p class="nav-label contact-label">{copy.sidebar.contacts}</p>
          <div class="social-links">
            <a href={import.meta.env.PUBLIC_LINKEDIN_URL || "https://www.linkedin.com/"} target="_blank" rel="noreferrer" aria-label={copy.sidebar.linkedin}><span class="social-icon" aria-hidden="true">in</span><span class="social-name">{copy.sidebar.linkedin}</span><span class="social-arrow" aria-hidden="true">↗</span></a>
            <a href={import.meta.env.PUBLIC_GITHUB_URL || "https://github.com/"} target="_blank" rel="noreferrer" aria-label={copy.sidebar.github}><span class="social-icon" aria-hidden="true">⌘</span><span class="social-name">{copy.sidebar.github}</span><span class="social-arrow" aria-hidden="true">↗</span></a>
          </div>
          <div class="language-switcher"><span>{copy.sidebar.language}</span><small>{copy.sidebar.languageHint}</small></div>
        </div>
      </aside>
      <button class="sidebar-scrim" type="button" data-menu-toggle aria-label="Close navigation"></button>
      <section id="main-content" class="chat-workspace" aria-label="Portfolio workspace" tabindex="-1">
        <header class="workspace-header">
          <button class="icon-button desktop-hidden" data-menu-toggle type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="Open navigation"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg></button>
          <div class="workspace-context"><span class="context-dot" aria-hidden="true"></span><span>professional journey / <strong id="active-section">{copy.sidebar.portfolio.toLowerCase()}</strong></span></div>
        </header>
        <div class="section-grid">
          {sections.map((section, index) => (
            <article id={`panel-${section.id}`} class:list={["portfolio-section", { active: index === 0 }]} data-panel={section.id} aria-labelledby={`heading-${section.id}`} hidden={index !== 0} tabindex="-1">
              <div class="section-heading"><p class="eyebrow">{section.content.eyebrow}</p><h1 id={`heading-${section.id}`}>{section.content.title}</h1><p class="section-description">{section.content.description}</p></div>
              <div class="section-facts">{section.content.items.map((item) => <div class="fact"><span>{item.label}</span><strong>{item.value}</strong></div>)}</div>
              <div class="section-note"><span aria-hidden="true">✦</span><p>Use the chat to explore this section in more depth.</p></div>
            </article>
          ))}
        </div>
        <Chatbot copy={copy.chat} />
        <footer class="workspace-footer"><span>Jorge Ignacio Sánchez / 2026</span><span>{copy.chat.disclaimer}</span></footer>
      </section>
    </main>
    <script>
      const sections = ["portfolio", "projects", "studies", "career", "about"];
      const appShell = document.querySelector(".app-shell"); const sidebar = document.querySelector(".sidebar"); const workspace = document.querySelector(".chat-workspace"); const activeSection = document.querySelector("#active-section"); const panels = document.querySelectorAll<HTMLElement>("[data-panel]"); const navItems = document.querySelectorAll<HTMLButtonElement>("[data-section]"); const sidebarToggle = document.querySelector<HTMLButtonElement>("[data-sidebar-toggle]"); const menuButtons = document.querySelectorAll<HTMLButtonElement>("[data-menu-toggle]");
      const setMenuOpen = (open: boolean) => { sidebar?.classList.toggle("open", open); menuButtons.forEach((button) => { button.setAttribute("aria-expanded", String(open)); if (button.classList.contains("mobile-menu") || button.classList.contains("desktop-hidden")) button.setAttribute("aria-label", open ? "Close navigation" : "Open navigation"); }); };
      menuButtons.forEach((button) => button.addEventListener("click", () => setMenuOpen(!sidebar?.classList.contains("open"))));
      const selectSection = (id: string, label: string, updateUrl = true) => { navItems.forEach((item) => { const selected = item.dataset.section === id; item.classList.toggle("active", selected); item.setAttribute("aria-current", selected ? "page" : "false"); }); panels.forEach((panel) => { const selected = panel.dataset.panel === id; panel.classList.toggle("active", selected); panel.hidden = !selected; }); workspace?.classList.toggle("section-view", id !== "portfolio"); appShell?.classList.toggle("sidebar-collapsed", id !== "portfolio"); if (activeSection) activeSection.textContent = label.toLowerCase(); setMenuOpen(false); if (updateUrl) history.replaceState(null, "", `#${id}`); document.querySelector<HTMLElement>(`[data-panel="${id}"]`)?.focus({ preventScroll: true }); };
      navItems.forEach((button) => button.addEventListener("click", () => selectSection(button.dataset.section ?? "portfolio", button.textContent?.trim() ?? "Portfolio")));
      sidebarToggle?.addEventListener("click", () => { const collapsed = appShell?.classList.toggle("sidebar-collapsed") ?? false; sidebarToggle.setAttribute("aria-expanded", String(!collapsed)); sidebarToggle.setAttribute("aria-label", collapsed ? "Expand menu" : "Collapse menu"); });
      const initialId = window.location.hash.slice(1); const initialSection = sections.includes(initialId) ? initialId : "portfolio"; const initialButton = document.querySelector<HTMLButtonElement>(`[data-section="${initialSection}"]`); selectSection(initialSection, initialButton?.textContent?.trim() ?? "Portfolio", false); window.addEventListener("hashchange", () => { const id = window.location.hash.slice(1); if (sections.includes(id)) { const button = document.querySelector<HTMLButtonElement>(`[data-section="${id}"]`); selectSection(id, button?.textContent?.trim() ?? "Portfolio", false); } });
    </script>
  </body>
</html>

---
import '../styles/global.css';
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="theme-color" content="#080b12"/><meta name="description" content="Nacho Sanchez — AI Engineer & Full Stack Developer. Explore projects, experience and applied AI."/><link rel="canonical" href="https://nachosanchez.com.ar/"/><title>Nacho Sanchez · AI Engineer</title></head>
<body class="entry-page"><main class="entry-shell" aria-labelledby="entry-title">
  <p class="entry-kicker">AI ENGINEERING / FULL STACK</p>
  <div class="entry-monogram" aria-hidden="true">NS<span></span></div>
  <h1 id="entry-title">Nacho Sanchez<span>.</span></h1>
  <p class="entry-description"><span lang="es">Ideas que llegan a funcionar.</span><br/><span lang="en">Ideas that become working systems.</span></p>
  <div class="entry-status" role="status"><span class="entry-loader" aria-hidden="true"></span><span data-entry-status>Preparando portfolio / Preparing portfolio</span></div>
  <nav class="entry-languages" aria-label="Choose your language / Elegí tu idioma"><a href="/es/" lang="es" data-locale="es">Entrar en español <span aria-hidden="true">↗</span></a><a href="/en/" lang="en" data-locale="en">Enter in English <span aria-hidden="true">↗</span></a></nav>
  <noscript><style>.entry-status { display: none; }</style><p class="entry-noscript">Elegí un idioma para entrar. / Choose a language to enter.</p></noscript>
</main><footer class="entry-footer">Córdoba, Argentina <span>Python · TypeScript · AI</span></footer>
<script>
  import { readPreferredLocale, rememberLocale, resolveLocale } from '../shared/i18n/localePreference';
  const locale = resolveLocale(readPreferredLocale(), navigator.languages ?? [navigator.language]);
  const status = document.querySelector('[data-entry-status]');
  if (status) status.textContent = locale === 'es' ? 'Preparando tu portfolio en español…' : 'Preparing your portfolio in English…';
  const timer = window.setTimeout(() => { rememberLocale(locale); window.location.replace(`/${locale}/`); }, 1200);
  const pause = () => window.clearTimeout(timer);
  document.querySelectorAll<HTMLAnchorElement>('[data-locale]').forEach(link => {
    link.addEventListener('focus', pause); link.addEventListener('pointerenter', pause);
    link.addEventListener('click', () => { pause(); rememberLocale(link.dataset.locale === 'es' ? 'es' : 'en'); });
  });
</script></body></html>

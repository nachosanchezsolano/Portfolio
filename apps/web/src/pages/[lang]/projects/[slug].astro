---
import { getPublicProjects } from '../../../shared/content/projects';
import PortfolioLayout from '../../../shared/components/PortfolioLayout.astro';
import { getPortfolioCopy } from '../../../shared/content/portfolio';
import type { Locale } from '../../../shared/i18n';
// Chatbot de IA desactivado temporalmente. Implementación conservada para pruebas y futura reintegración.
// import Chatbot from '../../../features/home/components/Chatbot.astro';
// import { getCopy } from '../../../shared/i18n';

export function getStaticPaths() {
  return (['en', 'es'] as const).flatMap(locale => getPublicProjects(locale).map(project => ({ params: { lang: locale, slug: project.slug }, props: { project, locale } })));
}
const { project, locale } = Astro.props as { project: ReturnType<typeof getPublicProjects>[number]; locale: Locale };
const isSpanish = locale === 'es';
const copy = getPortfolioCopy(locale);
// Preserve the existing escaped Markdown subset; no runtime dependency is needed.
const escapeHtml = (value: string) => value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const content = project.body.split('\n\n').filter(Boolean).map(block => {
  if (block.startsWith('## ')) return `<h3>${escapeHtml(block.slice(3))}</h3>`;
  if (block.startsWith('# ')) return `<h2>${escapeHtml(block.slice(2))}</h2>`;
  if (block.split('\n').every(line => line.startsWith('- '))) return `<ul>${block.split('\n').map(line => `<li>${escapeHtml(line.slice(2))}</li>`).join('')}</ul>`;
  return `<p>${escapeHtml(block).replace(/\n/g, ' ')}</p>`;
}).join('');
const educational = ['aquanova', 'lessions'].includes(project.slug);
---
<PortfolioLayout locale={locale} title={`${project.title} | Nacho Sánchez`} description={`${project.title}: ${isSpanish ? 'caso de estudio y contribución de Jorge Ignacio Sánchez' : 'case study and contribution by Jorge Ignacio Sánchez'}.`} path={`projects/${project.slug}/`}>
  <div class="project-page container">
    <a class="back-link" href={`/${locale}/#work`}>{isSpanish ? '← Volver a los proyectos' : '← Back to projects'}</a>
    <header class="project-header">
      <p class="eyebrow">{educational ? (isSpanish ? 'Docencia / Proyecto educativo' : 'Teaching / Student project') : (isSpanish ? 'Desarrollo / Caso de estudio' : 'Development / Case study')}</p>
      <h1>{project.title}</h1>
      <p class="project-meta">{project.status}{project.period && ` · ${project.period}`}</p>
      <p class="project-meta">{project.role}</p>
      <div class="project-evidence-links">
        {project.evidence.demo && <a class="button button-primary" href={project.evidence.demo} target="_blank" rel="noreferrer">{copy.live} ↗</a>}
        {project.evidence.github && <a class="button button-outline" href={project.evidence.github} target="_blank" rel="noreferrer">GitHub ↗</a>}
      </div>
      <div class="project-tags">{project.technologies.map(technology => <span>{technology}</span>)}</div>
      {educational && <p class="project-student-note">{copy.studentWork}</p>}
    </header>
    <article class="project-content" set:html={content} />
    <a class="text-link" href={`/${locale}/#contact`}>{copy.contact}<span aria-hidden="true">↗</span></a>
    <!-- Montaje experimental desactivado: <Chatbot copy={getCopy(locale).chat} locale={locale} pageContext={project.title} /> -->
  </div>
</PortfolioLayout>

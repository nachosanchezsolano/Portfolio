---
import Chatbot from "./Chatbot.astro";
import { getCopy, type Locale } from "../../../shared/i18n";
import { getProjects } from "../../../shared/content/projects";
import "../../../styles/global.css";

interface Props { locale: Locale }
const { locale } = Astro.props;
const isSpanish = locale === "es";
const copy = getCopy(locale);
const projects = getProjects(locale);
const featuredSlugs = ["ai-portfolio-assistant", "grupo-eurosa", "ai-sales-chatbot"];
const featuredProjects = featuredSlugs.map((slug) => projects.find((project) => project.slug === slug)).filter(Boolean);
const projectSummary = (body: string) => body.split("\n\n").find((paragraph) => paragraph && !paragraph.startsWith("#"))?.replace(/\n/g, " ") ?? (isSpanish ? "Proyecto de ingeniería construido alrededor de un problema real." : "Engineering project built around a real problem.");
const text = isSpanish ? { title: "Construyo productos full stack con AI.", lede: "Soy Nacho, AI Engineer y desarrollador full stack. Conecto Python, TypeScript y modelos de IA para resolver problemas de producto, desde el backend hasta la experiencia web.", viewWork: "Ver mi trabajo", ask: "Preguntarle a mi asistente AI", openRemote: "Disponible para oportunidades remotas", focus: "Ingeniería de software primero. AI donde genera ventaja.", proof: [["De punta a punta", "Del problema de producto al despliegue"], ["Producción", "Websites, dashboards y sistemas de datos"], ["AI aplicada", "LLMs, RAG y workflows inteligentes"]], workEyebrow: "Trabajo de ingeniería seleccionado", workTitle: "Construido para ser útil.", workTitle2: "Diseñado para durar.", workIntro: "Tres proyectos que muestran cómo paso de una restricción real a un producto funcional y observable.", caseStudy: "Leer el caso de estudio de ingeniería", assistantEyebrow: "Una feature de este portfolio", assistantTitle: "¿No querés navegar?", assistantBody: "Preguntá por mi trabajo, decisiones de ingeniería, experiencia o los sistemas detrás de estos proyectos.", assistantOpen: "Abrir asistente", principlesEyebrow: "Cómo construyo software", principlesTitle: "La buena ingeniería hace visible el contexto.", experienceEyebrow: "Experiencia", experienceTitle: "Software que llega al mundo real.", experienceBody: "Desarrollé websites, dashboards, automatizaciones y sistemas orientados a datos para clientes, instituciones educativas y proyectos tecnológicos.", experienceBody2: "Como desarrollador independiente y docente, trabajo con contexto de producto, backend, integraciones AI, testing y decisiones técnicas.", contact: "Contactame", toolkit: "Herramientas técnicas", toolkitTitle: "El stack sigue al problema.", aboutEyebrow: "Sobre mí", aboutTitle: "Curiosidad convertida en sistemas que funcionan.", aboutBody: "Soy Full-Stack Developer especializado en AI Engineering, con formación técnica en Data Science y soluciones basadas en datos.", aboutBody2: "Me interesa construir software útil, simple, seguro, observable y fácil de evolucionar.", contactEyebrow: "Próximo capítulo", contactTitle: "Construyamos algo útil.", contactBody: "Abierto a oportunidades de Full-Stack y AI Engineering.", email: "Enviar email", navWork: "Trabajo", navExperience: "Experiencia", navAbout: "Sobre mí", navAsk: "Preguntar a AI", language: "EN", projectKinds: ["Producto AI", "Full-stack en producción", "Backend + AI engineering"] } : { title: "I build full-stack products with AI.", lede: "I’m Nacho, an AI Engineer and full-stack developer. I connect Python, TypeScript and AI models to solve product problems, from backend systems to web experiences.", viewWork: "View my work", ask: "Ask my AI assistant", openRemote: "Open to remote opportunities", focus: "Software engineering first. AI where it adds value.", proof: [["End-to-end", "From product problem to deployment"], ["Production", "Websites, dashboards and data systems"], ["AI applied", "LLMs, RAG and intelligent workflows"]], workEyebrow: "Selected engineering work", workTitle: "Built to be useful.", workTitle2: "Designed to hold up.", workIntro: "Three projects that show how I move from a real constraint to a working, observable product.", caseStudy: "Read engineering case study", assistantEyebrow: "A feature of this portfolio", assistantTitle: "Don’t want to browse?", assistantBody: "Ask about my work, engineering decisions, experience or the systems behind these projects.", assistantOpen: "Open assistant", principlesEyebrow: "How I build software", principlesTitle: "Good engineering makes context visible.", experienceEyebrow: "Experience", experienceTitle: "Software that meets the real world.", experienceBody: "I have developed websites, dashboards, automations and data-oriented systems for clients, educational institutions and technology projects.", experienceBody2: "As an independent developer and teacher, I work across product context, backend systems, AI integrations, testing and technical decision-making.", contact: "Get in touch", toolkit: "Technical toolkit", toolkitTitle: "The stack follows the problem.", aboutEyebrow: "About", aboutTitle: "Curiosity into working systems.", aboutBody: "I am a Full-Stack Developer specialised in AI Engineering, with a technical background in Data Science and data-driven solutions.", aboutBody2: "I care about building useful, simple, secure, observable and evolvable software.", contactEyebrow: "Next chapter", contactTitle: "Let’s build something useful.", contactBody: "Open to Full-Stack and AI Engineering opportunities.", email: "Email me", navWork: "Work", navExperience: "Experience", navAbout: "About", navAsk: "Ask AI", language: "ES", projectKinds: ["AI product", "Production full-stack", "Backend + AI engineering"] };
const linkedinUrl = import.meta.env.PUBLIC_LINKEDIN_URL || "https://www.linkedin.com/in/jorge-ignacio-sanchez/";
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL || "https://github.com/nachosanchezsolano/Portfolio";
const alternateLocale = isSpanish ? "en" : "es";
---

<html lang={locale}><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="theme-color" content="#080B12" /><meta name="description" content={text.lede} /><link rel="canonical" href={`https://nachosanchez.com.ar/${locale}/`} /><link rel="alternate" hreflang="en" href="https://nachosanchez.com.ar/en/" /><link rel="alternate" hreflang="es" href="https://nachosanchez.com.ar/es/" /><link rel="alternate" hreflang="x-default" href="https://nachosanchez.com.ar/" /><meta property="og:type" content="website" /><meta property="og:title" content={`${text.title} — Jorge Ignacio Sánchez`} /><meta property="og:description" content={text.lede} /><meta property="og:url" content={`https://nachosanchez.com.ar/${locale}/`} /><title>{text.title} — Jorge Ignacio Sánchez</title><script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "Person", name: "Jorge Ignacio Sánchez", url: `https://nachosanchez.com.ar/${locale}/`, jobTitle: "AI Engineer & Full Stack Developer", sameAs: [linkedinUrl, githubUrl] })} /></head><body>
  <a class="skip-link" href="#main-content">{isSpanish ? "Ir al contenido" : "Skip to content"}</a>
  <header class="site-header"><a class="site-brand" href={`/${locale}/`} aria-label={isSpanish ? "AI Engenier- Nacho Sanchez — Inicio" : "AI Engenier- Nacho Sanchez — Home"}><span class="brand-glyph" aria-hidden="true">✦</span><span>AI Engenier- Nacho Sanchez</span></a><nav class="site-nav" aria-label={isSpanish ? "Navegación principal" : "Primary navigation"}><a href="#work">{text.navWork}</a><a href="#experience">{text.navExperience}</a><a href="#about">{text.navAbout}</a><a href={githubUrl} target="_blank" rel="noreferrer">GitHub ↗</a><a class="locale-link" href={`/${alternateLocale}/`} lang={alternateLocale}>{text.language}</a><button class="nav-ai-button" type="button" data-chat-open>{text.navAsk} <span aria-hidden="true">✦</span></button></nav><button class="mobile-nav-toggle" type="button" data-mobile-nav aria-expanded="false" aria-controls="site-navigation" aria-label={isSpanish ? "Abrir navegación" : "Open navigation"}>{isSpanish ? "Menú" : "Menu"}</button></header>
  <nav id="site-navigation" class="mobile-nav" aria-label={isSpanish ? "Navegación móvil" : "Mobile navigation"}><a href="#work">{text.navWork}</a><a href="#experience">{text.navExperience}</a><a href="#about">{text.navAbout}</a><a href={`/${alternateLocale}/`} lang={alternateLocale}>{text.language}</a><button type="button" data-chat-open>{text.navAsk} ✦</button></nav>
  <main id="main-content">
    <section class="hero section-container" aria-labelledby="hero-title"><div class="hero-copy"><p class="eyebrow">AI Engineer · Full Stack · Argentina</p><h1 id="hero-title">{text.title}</h1><p class="hero-lede">{text.lede}</p><div class="hero-actions"><a class="button button-primary" href="#work">{text.viewWork} <span aria-hidden="true">↓</span></a><button class="button button-secondary" type="button" data-chat-open>{text.ask} <span aria-hidden="true">✦</span></button></div><p class="hero-meta">TypeScript · Python · Astro · Next.js · LLMs · RAG<br /><span>{text.openRemote}</span></p></div><aside class="system-evidence" aria-labelledby="system-evidence-title"><div class="system-evidence-top"><span class="system-dot" aria-hidden="true"></span><span>{isSpanish ? "Dentro de este portfolio" : "Inside this portfolio"}</span><span>01 / RAG</span></div><h2 id="system-evidence-title">{isSpanish ? "Una pregunta.\nEvidencia detrás." : "One question.\nEvidence behind it."}</h2><ol class="system-pipeline"><li><span>01</span><div><strong>{isSpanish ? "Tu pregunta" : "Your question"}</strong><small>Astro → FastAPI</small></div></li><li><span>02</span><div><strong>{isSpanish ? "Contexto relevante" : "Relevant context"}</strong><small>Workers AI → Vectorize</small></div></li><li><span>03</span><div><strong>{isSpanish ? "Respuesta con fuentes" : "Answer with sources"}</strong><small>{isSpanish ? "Markdown público · Evidencia verificable" : "Public Markdown · Verifiable evidence"}</small></div></li></ol><a class="text-link" href={`/${locale}/projects/ai-portfolio-assistant/`}>{isSpanish ? "Explorar la arquitectura" : "Explore the architecture"} ↗</a></aside></section>
    <section class="proof-bar section-container" aria-label="Proof points">{text.proof.map(([title, description]) => <div><strong>{title}</strong><span>{description}</span></div>)}</section>
    <section id="work" class="content-section section-container" aria-labelledby="work-title"><div class="section-intro"><p class="eyebrow">{text.workEyebrow}</p><h2 id="work-title">{text.workTitle}<br /><em>{text.workTitle2}</em></h2><p>{text.workIntro}</p></div><div class="project-list">{featuredProjects.map((project, index) => project && <article class="featured-project"><div class="project-index">0{index + 1}</div><div class="project-main"><p class="project-kind">{text.projectKinds[index]}</p><h3>{project.title}</h3><p>{projectSummary(project.body)}</p><p class="project-state">{project.status}{project.period && ` · ${project.period}`}<br />{project.role}</p><div class="project-tech">{project.technologies.slice(0, 6).map((technology) => <span>{technology}</span>)}</div><a class="text-link" href={`/${locale}/projects/${project.slug}/`}>{text.caseStudy} <span aria-hidden="true">↗</span></a><div class="project-evidence-links">{project.evidence.demo && <a class="supporting-link" href={project.evidence.demo} target="_blank" rel="noreferrer">{isSpanish ? "Ver proyecto" : "Live project"} ↗</a>}{project.evidence.github && <a class="supporting-link" href={project.evidence.github} target="_blank" rel="noreferrer">GitHub ↗</a>}</div></div></article>)}</div></section>
    <section class="assistant-section section-container" aria-labelledby="assistant-title"><div><p class="eyebrow">{text.assistantEyebrow}</p><h2 id="assistant-title">{text.assistantTitle}</h2><p>{text.assistantBody}</p></div><div class="assistant-questions"><button type="button" data-suggestion={isSpanish ? "¿Qué sistemas de AI construiste?" : "What AI systems have you built?"}>{isSpanish ? "¿Qué sistemas de AI construiste?" : "What AI systems have you built?"} <span>↗</span></button><button type="button" data-suggestion={isSpanish ? "¿Por qué elegiste Cloudflare?" : "Why did you choose Cloudflare?"}>{isSpanish ? "¿Por qué elegiste Cloudflare?" : "Why did you choose Cloudflare?"} <span>↗</span></button><button type="button" data-suggestion={isSpanish ? "¿Qué experiencia tenés con desarrollo full stack?" : "What experience do you have with full-stack development?"}>{isSpanish ? "¿Qué experiencia tenés con desarrollo full stack?" : "What experience do you have with full-stack development?"} <span>↗</span></button></div><button class="button button-primary assistant-open" type="button" data-chat-open>{text.assistantOpen} <span aria-hidden="true">✦</span></button></section>
    <section id="principles" class="principles-section section-container" aria-labelledby="principles-title"><div class="section-intro"><p class="eyebrow">{text.principlesEyebrow}</p><h2 id="principles-title">{text.principlesTitle}</h2></div><div class="principles-grid"><div><span>01</span><h3>Product thinking</h3><p>{isSpanish ? "Empiezo por el problema y las restricciones antes de elegir tecnologías." : "Start from the problem and constraints before choosing technologies."}</p></div><div><span>02</span><h3>Software engineering</h3><p>{isSpanish ? "Límites simples, contratos explícitos y código mantenible." : "Simple boundaries, explicit contracts and maintainable code."}</p></div><div><span>03</span><h3>Production</h3><p>{isSpanish ? "Deploy, monitoreo y manejo de fallos son parte de la feature." : "Deployment, monitoring and failure handling are part of the feature."}</p></div><div><span>04</span><h3>AI engineering</h3><p>{isSpanish ? "Los LLMs son componentes del sistema, no el sistema completo." : "LLMs are components of the system — not the system itself."}</p></div></div></section>
    <section id="experience" class="content-section section-container two-column-section" aria-labelledby="experience-title"><div class="section-intro"><p class="eyebrow">{text.experienceEyebrow}</p><h2 id="experience-title">{text.experienceTitle}</h2></div><div class="experience-copy"><ol class="experience-timeline"><li><span>{isSpanish ? "≈ 2024 — Actualidad" : "≈ 2024 — Present"}</span><h3>{isSpanish ? "Desarrollador independiente" : "Independent developer"}</h3><p>{isSpanish ? "Dos clientes activos. Relevamiento, frontend, backend, despliegue y mantenimiento; Grupo Eurosa y sistemas con agentes de IA." : "Two active clients. Requirements, frontend, backend, deployment and maintenance; Grupo Eurosa and AI agent systems."}</p></li><li><span>{isSpanish ? "Ago 2023 — Actualidad" : "Aug 2023 — Present"}</span><h3>{isSpanish ? "Docente de tecnología" : "Technology teacher"}</h3><p>{isSpanish ? "Programación, Estructuras de Datos y Testing. Aprendizaje basado en proyectos y acompañamiento de equipos de estudiantes." : "Programming, Data Structures and Testing. Project-based learning and mentoring student teams."}</p></li><li><span>{isSpanish ? "Mar 2021 — Jul 2023" : "Mar 2021 — Jul 2023"}</span><h3>Centro de Innovación y Tecnología · La Falda</h3><p>{isSpanish ? "Mantenimiento web y desarrollo de proyectos tecnológicos. Participé en más de diez proyectos y propuestas de financiación institucional." : "Web maintenance and technology projects. Contributed to more than ten projects and institutional funding proposals."}</p></li></ol><a class="text-link" href="mailto:dev@nachosanchez.com.ar">{text.contact} ↗</a></div></section>
    <section class="skills-section section-container" aria-labelledby="skills-title"><div class="section-intro"><p class="eyebrow">{text.toolkit}</p><h2 id="skills-title">{text.toolkitTitle}</h2></div><div class="skills-grid"><div><h3>Frontend</h3><p>TypeScript · JavaScript · React · Next.js · Astro</p></div><div><h3>Backend</h3><p>Python · FastAPI · Node.js · SQL · GraphQL</p></div><div><h3>AI engineering</h3><p>RAG · LLMs · Embeddings · Vector Search · AI APIs</p></div><div><h3>Infrastructure</h3><p>PostgreSQL · Docker · Cloudflare · Vercel · CI/CD</p></div></div></section>
    <section id="about" class="content-section section-container two-column-section" aria-labelledby="about-title"><div class="section-intro"><p class="eyebrow">{text.aboutEyebrow}</p><h2 id="about-title">{text.aboutTitle}</h2></div><div class="about-copy"><p>{text.aboutBody}</p><p>{text.aboutBody2}</p><p>{isSpanish ? "Técnico Superior en Ciencia de Datos · ISPC, 2024. Español nativo · Inglés B2." : "Higher Technical Degree in Data Science · ISPC, 2024. Native Spanish · B2 English."}</p></div></section>
    <section class="contact-section section-container" aria-labelledby="contact-title"><p class="eyebrow">{text.contactEyebrow}</p><h2 id="contact-title">{text.contactTitle}</h2><p>{text.contactBody}</p><div class="contact-links"><a class="button button-primary" href="mailto:dev@nachosanchez.com.ar">{text.email} ↗</a><a class="button button-secondary" href="/resume/nacho-sanchez-ai-engineer.pdf" target="_blank" rel="noreferrer">{isSpanish ? "Ver CV · PDF (ES)" : "View résumé · PDF (ES)"} ↗</a><a class="button button-secondary" href={linkedinUrl} target="_blank" rel="noreferrer">LinkedIn ↗</a><a class="button button-secondary" href={githubUrl} target="_blank" rel="noreferrer">GitHub ↗</a></div></section>
  </main>
  <div class="assistant-widget"><Chatbot copy={copy.chat} locale={locale} pageContext={isSpanish ? "Homepage del portfolio" : "Portfolio homepage"} /></div><footer class="site-footer section-container"><span>Jorge Ignacio Sánchez / 2026</span><span>{isSpanish ? "Construido con Astro · Las respuestas AI usan evidencia pública." : "Built with Astro · AI-assisted answers are grounded in public evidence."}</span></footer>
  <script>const mobileToggle = document.querySelector<HTMLButtonElement>("[data-mobile-nav]"), mobileNav = document.querySelector<HTMLElement>("#site-navigation"); mobileToggle?.addEventListener("click", () => { const open = mobileNav?.classList.toggle("open") ?? false; mobileToggle.setAttribute("aria-expanded", String(open)); mobileToggle.textContent = document.documentElement.lang === "es" ? (open ? "Cerrar" : "Menú") : (open ? "Close" : "Menu"); }); document.querySelectorAll(".mobile-nav a").forEach((link) => link.addEventListener("click", () => { mobileNav?.classList.remove("open"); mobileToggle?.setAttribute("aria-expanded", "false"); if (mobileToggle) mobileToggle.textContent = document.documentElement.lang === "es" ? "Menú" : "Menu"; }));</script>
</body></html>

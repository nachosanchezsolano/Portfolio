---
// Chatbot de IA desactivado temporalmente. Implementación conservada para pruebas
// y futura reintegración en codex/experimental-ai-chatbot. Ver docs/AI_CHATBOT_REACTIVATION.md.
// import Chatbot from './Chatbot.astro';
// import { getCopy } from '../../../shared/i18n';
import type { Locale } from '../../../shared/i18n';
import PortfolioLayout from '../../../shared/components/PortfolioLayout.astro';
import { getPortfolioCopy, projectOrder } from '../../../shared/content/portfolio';
import { getPublicProjects } from '../../../shared/content/projects';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = getPortfolioCopy(locale);
const allProjects = getPublicProjects(locale);
const projects = projectOrder.flatMap(slug => {
  const project = allProjects.find(item => item.slug === slug);
  return project ? [{ ...project, shortName: copy.projectNames[slug], category: copy.categories[slug], educational: ['aquanova', 'lessions'].includes(slug) }] : [];
});
const summary = (body: string) => body.split('\n\n').find(paragraph => paragraph && !paragraph.startsWith('#'))?.replace(/\n/g, ' ') ?? '';
---
<PortfolioLayout locale={locale}>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-scanline" aria-hidden="true"></div>
    <div class="hero-top mono"><p>{copy.eyebrow}</p><span>{copy.location} ↘</span></div>
    <div class="hero-grid">
      <h1 id="hero-title">{copy.headline.map((line, index) => <span class:list={{ 'acid': index > 1 }}>{line}</span>)}</h1>
      <div class="hero-aside">
        <div class="hero-index mono" aria-hidden="true"><span>DEV / EDU</span><span>01—05</span></div>
        <div class="hero-mark" aria-hidden="true">&lt;/&gt;</div>
        <p class="hero-intro">{copy.intro}</p>
        <div class="hero-actions"><a class="button button-primary" href="#work">{copy.view}<span aria-hidden="true">↓</span></a><a class="button button-outline" href="#contact">{copy.contact}<span aria-hidden="true">↗</span></a></div>
        <div class="hero-links mono"><a href="https://github.com/nachosanchezsolano/Portfolio" target="_blank" rel="noreferrer">GitHub ↗</a><a href="https://www.linkedin.com/in/jorge-ignacio-sanchez/" target="_blank" rel="noreferrer">LinkedIn ↗</a><a href="/resume/nacho-sanchez-ai-engineer.pdf" target="_blank" rel="noreferrer">{copy.cv} ↗</a></div>
      </div>
    </div>
    <div class="hero-bottom mono"><span>{locale === 'es' ? 'DESARROLLADOR + DOCENTE' : 'DEVELOPER + TEACHER'}</span><a href="#work">SCROLL {locale === 'es' ? 'PARA EXPLORAR' : 'TO EXPLORE'} ↓</a></div>
  </section>
  <div class="specialties" aria-label={locale === 'es' ? 'Áreas de trabajo' : 'Areas of work'}><div class="container mono">{copy.disciplines.map(item => <span>{item}</span>)}</div></div>
  <section id="work" class="section container" aria-labelledby="work-title">
    <div class="section-heading"><div><p class="eyebrow">{copy.workLabel}</p><h2 id="work-title">{copy.workTitle}</h2></div><p class="section-description">{copy.workIntro}</p></div>
    <div class="project-list">{projects.map((project, index) => <article class:list={['project-row', { educational: project.educational }]} id={project.slug === 'aquanova' ? 'educational-projects' : undefined}>
      <a class="project-main-link" href={`/${locale}/projects/${project.slug}/`} aria-label={`${copy.caseStudy}: ${project.title}`}>
        <div class="project-number mono">0{index + 1}</div>
        <div class="project-main"><p class="project-category mono">{project.category}</p><h3>{project.shortName}</h3><p class="project-summary">{summary(project.body)}</p><p class="project-tools mono">{project.technologies.slice(0, 5).join(' / ')}</p></div>
        <div class="project-side mono"><span>{project.period || (locale === 'es' ? 'PRUEBAS CERRADAS' : 'CLOSED TESTING')}</span><span class="project-arrow" aria-hidden="true">↗</span><span class="project-status">{project.status}</span></div>
        <div class="project-preview" aria-hidden="true"><span class="mono">{copy.previewLabel} / 0{index + 1}</span><strong>{project.shortName}</strong><span class="mono">{project.technologies.slice(0, 3).join(' · ')}</span></div>
      </a>
      <div class="project-row-footer"><span>{project.role}</span>{project.evidence.demo && <a href={project.evidence.demo} target="_blank" rel="noreferrer">{copy.live} ↗</a>}</div>
    </article>)}</div>
    <p class="student-note mono">↳ {copy.studentWork}</p>
  </section>
  <section id="experience" class="section container split-section" aria-labelledby="experience-title">
    <div class="section-heading"><div><p class="eyebrow">{copy.experienceLabel}</p><h2 id="experience-title">{copy.experienceTitle}</h2></div></div>
    <ol class="experience-list">{copy.experience.map(item => <li><p class="eyebrow">{item.date}</p><h3>{item.title}</h3><p class="experience-place mono">{item.place}</p><p>{item.body}</p></li>)}</ol>
  </section>
  <section id="teaching" class="teaching-section" aria-labelledby="teaching-title"><div class="container section">
    <div class="section-heading"><div><p class="eyebrow">{copy.teachingLabel}</p><h2 id="teaching-title">{copy.teachingTitle}</h2></div><p class="section-description">{copy.teachingIntro}</p></div>
    <div class="teaching-grid">{copy.teaching.map((item, index) => <article><span class="teaching-number mono">0{index + 1} /</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
    <a class="text-link" href="#educational-projects">{copy.educationalLink}<span aria-hidden="true">↗</span></a>
  </div></section>
  <section id="skills" class="section container" aria-labelledby="skills-title">
    <div class="section-heading"><div><p class="eyebrow">{copy.skillsLabel}</p><h2 id="skills-title">{copy.skillsTitle}</h2></div></div>
    <div class="skills-list">{copy.skills.map((item, index) => <article><span class="mono">0{index + 1}</span><h3>{item.title}</h3><div><p class="skill-tools mono">{item.tools}</p><p>{item.use}</p></div></article>)}</div>
  </section>
  <section id="services" class="section container" aria-labelledby="services-title">
    <div class="section-heading"><div><p class="eyebrow">{copy.servicesLabel}</p><h2 id="services-title">{copy.servicesTitle}</h2></div><a class="text-link" href="#contact">{copy.serviceAction}<span aria-hidden="true">↗</span></a></div>
    <div class="services-grid">{copy.services.map((item, index) => <article><span class="mono">0{index + 1}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
  </section>
  <section id="process" class="section container" aria-labelledby="process-title">
    <div class="section-heading"><div><p class="eyebrow">{copy.processLabel}</p><h2 id="process-title">{copy.processTitle}</h2></div></div>
    <ol class="process-list">{copy.process.map(([title, body], index) => <li><span class="mono">0{index + 1}</span><h3>{title}</h3><p>{body}</p></li>)}</ol>
  </section>
  <section id="about" class="section container split-section" aria-labelledby="about-title">
    <div class="section-heading"><div><p class="eyebrow">{copy.aboutLabel}</p><h2 id="about-title">{copy.aboutTitle}</h2></div></div>
    <div class="about-copy"><p class="about-lead">{copy.about}</p><p>{copy.aboutSecond}</p><dl class="education-list">{copy.education.map(([year, title, place]) => <div><dt class="mono">{year}</dt><dd><strong>{title}</strong><span>{place}</span></dd></div>)}</dl><p class="mono">{copy.languages}</p><a class="text-link" href="/resume/nacho-sanchez-ai-engineer.pdf" target="_blank" rel="noreferrer">{copy.cv}<span aria-hidden="true">↗</span></a></div>
  </section>
  <section id="contact" class="contact-section" aria-labelledby="contact-title"><div class="container section">
    <p class="eyebrow">{copy.contactLabel}</p><h2 id="contact-title">{copy.contactTitle}</h2><div class="contact-bottom"><p>{copy.contactBody}</p><a class="contact-email" href="mailto:dev@nachosanchez.com.ar">dev@nachosanchez.com.ar<span aria-hidden="true">↗</span></a></div>
    <div class="contact-links mono"><a href="mailto:dev@nachosanchez.com.ar">{copy.email} ↗</a><a href="https://www.linkedin.com/in/jorge-ignacio-sanchez/" target="_blank" rel="noreferrer">LinkedIn ↗</a><a href="https://github.com/nachosanchezsolano/Portfolio" target="_blank" rel="noreferrer">GitHub ↗</a></div>
  </div></section>
  <!-- Chatbot de IA desactivado temporalmente. Implementación conservada para pruebas y futura reintegración.
       Montaje experimental: <Chatbot copy={getCopy(locale).chat} locale={locale} />
       Ver docs/AI_CHATBOT_REACTIVATION.md antes de reactivarlo. -->
</PortfolioLayout>

---
import type { getCopy } from '../../../shared/i18n';
type ChatCopy = ReturnType<typeof getCopy>['chat'];
interface Props { copy: ChatCopy; locale?: 'en' | 'es'; pageContext?: string }
const { copy, locale = 'en', pageContext = '' } = Astro.props;
---
<section class="chat-screen is-collapsed" aria-label={copy.eyebrow} data-locale={locale} data-page-context={pageContext} data-copy={JSON.stringify(copy)}>
  <div class="chat-teaser">
    <div class="teaser-mark" aria-hidden="true">✦</div>
    <div class="teaser-copy"><p class="eyebrow">{copy.eyebrow}</p><strong>{copy.title}</strong><small>{copy.subtitle}</small></div>
    <button class="teaser-action" type="button" data-chat-open aria-label={copy.open}>{copy.talk} <span aria-hidden="true">↗</span></button>
  </div>
  <div class="chat-panel" role="dialog" aria-modal="false" aria-label={copy.eyebrow}>
    <div class="chat-panel-bar"><strong>{copy.eyebrow}</strong><button class="chat-collapse" type="button" data-chat-close aria-label={copy.close}>×</button></div>
    <div class="chat-intro"><p class="eyebrow">{copy.eyebrow}</p><h2>{copy.title}</h2><p class="chat-subtitle">{copy.subtitle}</p></div>
    <div id="messages" class="messages" aria-live="polite" aria-relevant="additions"><div class="message assistant"><div class="message-content"><p>{copy.welcome}</p></div></div></div>
    <div class="suggestions" aria-label={copy.suggestionsLabel}>{copy.suggestions.map(suggestion => <button class="suggestion" type="button" data-suggestion={suggestion}>{suggestion}<span aria-hidden="true">↗</span></button>)}</div>
    <div id="chat-error" class="chat-error" role="alert" hidden><span data-error-message></span><button type="button" data-retry hidden>{copy.retry}</button></div>
    <form id="chat-form" class="chat-form" aria-busy="false"><label class="sr-only" for="question">{copy.placeholder}</label><textarea id="question" name="question" rows="1" maxlength="1200" autocomplete="off" spellcheck="true" placeholder={copy.placeholder} aria-describedby="chat-disclaimer"></textarea><button class="send-button" type="submit" aria-label={copy.send}><span class="send-icon" aria-hidden="true">↑</span><span class="send-spinner" aria-hidden="true"></span></button></form>
    <div class="chat-panel-footer"><p id="chat-disclaimer" class="disclaimer">{copy.disclaimer}</p><button type="button" data-chat-reset>{copy.reset}</button></div>
  </div>
</section>
<script>
  import { askPortfolio, resetChatSession } from '../services/chatService';
  import { ChatRequestError, type ErrorKind } from '../services/chatTransport';
  import { chatStore } from '../stores/chatStore';
  import { createMessage, type ChatMessage } from '../entities/chat';
  import { formatAssistantMessage } from '../services/messageFormatter';
  import { sourceLinks } from '../services/sourceLinks';
  import { PendingQuestion, retryDelay } from '../services/chatRecovery';
  import { rememberLocale } from '../../../shared/i18n/localePreference';
  import type { getCopy } from '../../../shared/i18n';

  const screen = document.querySelector<HTMLElement>('.chat-screen');
  const form = document.querySelector<HTMLFormElement>('#chat-form');
  const input = document.querySelector<HTMLTextAreaElement>('#question');
  const messages = document.querySelector<HTMLDivElement>('#messages');
  const error = document.querySelector<HTMLDivElement>('#chat-error');
  const errorMessage = document.querySelector<HTMLElement>('[data-error-message]');
  const retry = document.querySelector<HTMLButtonElement>('[data-retry]');
  const reset = document.querySelector<HTMLButtonElement>('[data-chat-reset]');
  const sendButton = document.querySelector<HTMLButtonElement>('.send-button');
  const copy = JSON.parse(screen?.dataset.copy ?? '{}') as ReturnType<typeof getCopy>['chat'];
  const locale = screen?.dataset.locale === 'es' ? 'es' : 'en';
  rememberLocale(locale);
  let lastQuestion = '', errorKind: ErrorKind | null = null;
  const pendingQuestion = new PendingQuestion();
  let retryAvailableAt = 0;
  let recoveryTimer: ReturnType<typeof setTimeout> | undefined;
  let opener: HTMLElement | null = null;
  const appendMessage = (message: ChatMessage) => {
    const wrapper = document.createElement('div'); wrapper.className = `message ${message.role}`;
    const body = document.createElement('div'); body.className = 'message-content';
    if (message.role === 'assistant') body.append(formatAssistantMessage(message.content));
    else { const paragraph = document.createElement('p'); paragraph.textContent = message.content; body.append(paragraph); }
    const links = sourceLinks(message.sources ?? [], locale);
    if (links.length) {
      const nav = document.createElement('nav'); nav.className = 'message-sources'; nav.setAttribute('aria-label', copy.sources);
      const label = document.createElement('span'); label.textContent = copy.sources; nav.append(label);
      for (const source of links) { const link = document.createElement('a'); link.href = source.href; link.textContent = source.label; nav.append(link); }
      body.append(nav);
    }
    wrapper.append(body); return wrapper;
  };
  const render = () => {
    const state = chatStore.getState();
    messages?.replaceChildren(...state.messages.map(appendMessage));
    if (error && errorMessage) {
      error.hidden = !state.error; errorMessage.textContent = state.error ?? '';
      if (retry) { retry.hidden = !state.error || !['network', 'timeout', 'invalid', 'rate', 'pending'].includes(errorKind ?? ''); retry.disabled = state.isLoading || Date.now() < retryAvailableAt; }
    }
    form?.setAttribute('aria-busy', String(state.isLoading));
    if (sendButton) { sendButton.disabled = state.isLoading || errorKind === 'session' || Date.now() < retryAvailableAt; sendButton.toggleAttribute('data-loading', state.isLoading); }
    if (reset) reset.disabled = state.isLoading;
    if (messages) messages.scrollTop = messages.scrollHeight;
  };
  const setChatOpen = (open: boolean) => {
    screen?.classList.toggle('is-collapsed', !open);
    if (open) { opener = document.activeElement as HTMLElement; input?.focus(); }
    else opener?.focus();
  };
  chatStore.reset(copy.welcome); chatStore.subscribe(render); render();
  document.querySelectorAll('[data-chat-open]').forEach(button => button.addEventListener('click', () => setChatOpen(true)));
  document.querySelectorAll('[data-chat-close]').forEach(button => button.addEventListener('click', () => setChatOpen(false)));
  const submitQuestion = async (value: string) => {
    if (!input || chatStore.getState().isLoading || errorKind === 'session' || Date.now() < retryAvailableAt) return;
    const question = value.trim();
    if (!question || question.length > 1200 || question.split(/\s+/).length > 500) {
      errorKind = 'validation'; chatStore.setError(copy.validation); return;
    }
    lastQuestion = question; errorKind = null; chatStore.setError(null);
    const logicalQuestion = pendingQuestion.begin(question);
    if (logicalQuestion.isNew) chatStore.addMessage(createMessage('user', question));
    input.value = ''; input.style.height = 'auto'; chatStore.setLoading(true);
    try { chatStore.addMessage(await askPortfolio(question, { locale, pageContext: screen?.dataset.pageContext, requestId: logicalQuestion.requestId })); pendingQuestion.complete(); }
    catch (caught) {
      errorKind = caught instanceof ChatRequestError ? caught.kind : 'network';
      const errors = { network: copy.offline, timeout: copy.timeout, rate: copy.rate, session: copy.session, validation: copy.validation, invalid: copy.error, cancelled: copy.error, pending: copy.pending };
      input.value = question;
      retryAvailableAt = Date.now() + retryDelay(errorKind);
      clearTimeout(recoveryTimer);
      recoveryTimer = setTimeout(render, retryDelay(errorKind));
      chatStore.setError(errors[errorKind]);
    } finally { chatStore.setLoading(false); }
  };
  form?.addEventListener('submit', event => { event.preventDefault(); void submitQuestion(input?.value ?? ''); });
  retry?.addEventListener('click', () => void submitQuestion(lastQuestion));
  reset?.addEventListener('click', () => { resetChatSession(); pendingQuestion.complete(); clearTimeout(recoveryTimer); retryAvailableAt = 0; errorKind = null; lastQuestion = ''; if (input) input.value = ''; chatStore.reset(copy.welcome); input?.focus(); });
  document.querySelectorAll<HTMLButtonElement>('[data-suggestion]').forEach(button => button.addEventListener('click', () => { setChatOpen(true); void submitQuestion(button.dataset.suggestion ?? ''); }));
  input?.addEventListener('keydown', event => { if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) { event.preventDefault(); void submitQuestion(input.value); } });
  input?.addEventListener('input', () => { input.style.height = 'auto'; input.style.height = `${Math.min(input.scrollHeight, 160)}px`; });
  screen?.addEventListener('keydown', event => { if (event.key === 'Escape') setChatOpen(false); });
</script>

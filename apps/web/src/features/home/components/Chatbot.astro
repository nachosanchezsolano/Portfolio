---
import type { getCopy } from "../../../shared/i18n";
type ChatCopy = ReturnType<typeof getCopy>["chat"];
interface Props { copy: ChatCopy }
const { copy } = Astro.props;
---

<section class="chat-screen is-collapsed" aria-labelledby="chat-title" data-offline={copy.offline} data-error={copy.error}>
  <div class="chat-teaser">
    <div class="teaser-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 2 1.8 7.2L21 12l-7.2 1.8L12 21l-1.8-7.2L3 12l7.2-2.8L12 2Z" /></svg></div>
    <div class="teaser-copy"><p class="eyebrow">Professional journey</p><strong>Want to explore Jorge’s journey?</strong><small>Ask the portfolio assistant a question.</small></div>
    <button class="teaser-action" type="button" data-chat-open aria-label="Open chat">Talk <span aria-hidden="true">↗</span></button>
  </div>
  <div class="chat-panel" role="dialog" aria-modal="false" aria-labelledby="chat-title">
    <button class="chat-collapse" type="button" data-chat-close aria-label="Minimize chat"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button>
    <div class="chat-intro"><div class="assistant-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 2 1.8 7.2L21 12l-7.2 1.8L12 21l-1.8-7.2L3 12l7.2-2.8L12 2Z" /></svg></div><p class="eyebrow">{copy.eyebrow}</p><h1 id="chat-title">{copy.title}</h1><p class="chat-subtitle">{copy.subtitle}</p></div>
    <div id="messages" class="messages" aria-live="polite" aria-relevant="additions"><div class="message assistant"><div class="message-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 2 1.8 7.2L21 12l-7.2 1.8L12 21l-1.8-7.2L3 12l7.2-2.8L12 2Z" /></svg></div><div class="message-content"><p>{copy.welcome}</p><time>just now</time></div></div></div>
    <div class="suggestions" aria-label="Suggested questions">{copy.suggestions.map((suggestion) => <button class="suggestion" type="button" data-suggestion={suggestion}>{suggestion}<span aria-hidden="true">↗</span></button>)}</div>
    <div id="chat-error" class="chat-error" role="alert" hidden><span data-error-message></span><button type="button" data-retry hidden>Try again</button></div>
    <form id="chat-form" class="chat-form" aria-busy="false"><label class="sr-only" for="question">{copy.placeholder}</label><textarea id="question" name="question" rows="1" maxlength="1200" autocomplete="off" spellcheck="true" placeholder="Ask about the professional journey…" aria-describedby="chat-disclaimer"></textarea><button class="send-button" type="submit" aria-label={copy.send}><span class="send-icon" aria-hidden="true">↑</span><span class="send-spinner" aria-hidden="true"></span></button></form>
    <p id="chat-disclaimer" class="disclaimer">{copy.disclaimer}</p>
  </div>
</section>

<script>
  import { askPortfolio } from "../services/chatService";
  import { chatStore } from "../stores/chatStore";
  import { createMessage, validateQuestion } from "../entities/chat";
  const screen = document.querySelector<HTMLElement>(".chat-screen"); const form = document.querySelector<HTMLFormElement>("#chat-form"); const input = document.querySelector<HTMLTextAreaElement>("#question"); const messages = document.querySelector<HTMLDivElement>("#messages"); const error = document.querySelector<HTMLDivElement>("#chat-error"); const errorMessage = document.querySelector<HTMLElement>("[data-error-message]"); const retry = document.querySelector<HTMLButtonElement>("[data-retry]"); const sendButton = document.querySelector<HTMLButtonElement>(".send-button"); const offline = screen?.dataset.offline ?? "The knowledge base connection is unavailable."; const apiError = screen?.dataset.error ?? "Something went wrong."; let lastQuestion = "";
  const appendMessage = (role: "assistant" | "user", content: string) => { const wrapper = document.createElement("div"); wrapper.className = `message ${role}`; if (role === "assistant") { const mark = document.createElement("div"); mark.className = "message-mark"; mark.setAttribute("aria-hidden", "true"); mark.innerHTML = '<svg viewBox="0 0 24 24"><path d="m12 2 1.8 7.2L21 12l-7.2 1.8L12 21l-1.8-7.2L3 12l7.2-2.8L12 2Z" /></svg>'; wrapper.append(mark); } const body = document.createElement("div"); body.className = "message-content"; const paragraph = document.createElement("p"); paragraph.textContent = content; body.append(paragraph); wrapper.append(body); return wrapper; };
  const render = () => { if (!messages) return; const state = chatStore.getState(); messages.replaceChildren(...state.messages.map(({ role, content }) => appendMessage(role, content))); if (error && errorMessage) { error.hidden = !state.error; errorMessage.textContent = state.error ?? ""; retry?.toggleAttribute("hidden", !state.error); } if (form && sendButton) { form.setAttribute("aria-busy", String(state.isLoading)); sendButton.disabled = state.isLoading; sendButton.toggleAttribute("data-loading", state.isLoading); } messages.scrollTop = messages.scrollHeight; };
  const setChatOpen = (open: boolean) => { screen?.classList.toggle("is-collapsed", !open); if (open && window.matchMedia("(min-width: 761px)").matches) input?.focus(); };
  chatStore.subscribe(render); render(); document.querySelectorAll("[data-chat-open]").forEach((button) => button.addEventListener("click", () => setChatOpen(true))); document.querySelectorAll("[data-chat-close]").forEach((button) => button.addEventListener("click", () => setChatOpen(false)));
  const submitQuestion = async (value: string) => { if (!input || chatStore.getState().isLoading) return; try { const question = validateQuestion(value); lastQuestion = question; chatStore.addMessage(createMessage("user", question)); input.value = ""; chatStore.setLoading(true); const answer = await askPortfolio(question); chatStore.addMessage(answer); } catch (caught) { chatStore.setError(caught instanceof Error && caught.message.includes("connect") ? offline : apiError); } finally { chatStore.setLoading(false); } };
  form?.addEventListener("submit", (event) => { event.preventDefault(); void submitQuestion(input?.value ?? ""); }); retry?.addEventListener("click", () => void submitQuestion(lastQuestion)); document.querySelectorAll<HTMLButtonElement>("[data-suggestion]").forEach((button) => button.addEventListener("click", () => void submitQuestion(button.dataset.suggestion ?? ""))); input?.addEventListener("keydown", (event) => { if (event.key === "Enter" && !event.shiftKey) { event.preventDefault(); void submitQuestion(input.value); } }); input?.addEventListener("input", () => { input.style.height = "auto"; input.style.height = `${Math.min(input.scrollHeight, 160)}px`; });
</script>
